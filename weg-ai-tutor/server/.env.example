# Copy this file to .env and fill in your real keys.
# NEVER commit the real .env file to GitHub.

PORT=3000

# AI tutor brain (free tier, no card required)
# Get your key at: aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_key_here

# Speech-to-text AND text-to-speech: both use Google Cloud (Khmer supported).
# On your local dev machine, no key file needed — just run once:
#   gcloud auth application-default login
# This line is only needed if/when you deploy to a real server later,
# using a service account JSON key instead of your personal login:
# GOOGLE_APPLICATION_CREDENTIALS=path_to_google_service_account.json

# Database (MySQL, same pattern as Phrovilla)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=weg_ai_tutor
