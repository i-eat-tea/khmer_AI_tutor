# Copy this file to .env and fill in your real keys.
# NEVER commit the real .env file to GitHub.

PORT=3000

# AI tutor brain
OPENAI_API_KEY=your_openai_key_here

# Speech-to-text (choose one, matching your asr.js implementation)
GOOGLE_APPLICATION_CREDENTIALS=path_to_google_service_account.json
BYTEDANCE_ASR_KEY=your_bytedance_key_here

# Text-to-speech (choose one, matching your tts.js implementation)
# OpenAI TTS reuses OPENAI_API_KEY above.
GOOGLE_TTS_API_KEY=your_google_tts_key_here

# Database (MySQL, same pattern as Phrovilla)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=weg_ai_tutor
